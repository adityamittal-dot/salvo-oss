# Copy to `.env` and fill in. `.env` is gitignored — never commit real credentials.
#
# NOTE: For every site below, prefer `npm run login` over storing a password.
# That opens a real browser, you sign in by hand once (including 2FA / Google
# SSO), and the session cookie is saved to auth/sessions/<site>.json. Password
# replay on every run is what trips bot detection; a persisted session does not.
# The USER/PASS vars exist only as a fallback for sites with plain form login.

# --- Identity (used to fill application forms) ---
APPLICANT_NAME=""
APPLICANT_EMAIL=""
APPLICANT_PHONE=""
APPLICANT_LOCATION=""
APPLICANT_GITHUB=""
APPLICANT_LINKEDIN=""
APPLICANT_PORTFOLIO=""

# --- Work authorization (drives screening-question answers) ---
# Answered from these values rather than guessed by the model. Be accurate:
# a wrong answer here is a false statement on a real job application.
WORK_AUTH_US=""
WORK_AUTH_EU=""
WORK_AUTH_UK=""
WORK_AUTH_INDIA=""
REQUIRES_SPONSORSHIP=""

# --- Site credentials (fallback only; prefer `npm run login`) ---
WELLFOUND_USER=""
WELLFOUND_PASS=""

YC_USER=""
YC_PASS=""

SIMPLIFY_USER=""
SIMPLIFY_PASS=""

LINKEDIN_USER=""
LINKEDIN_PASS=""

# --- LLM for resume tailoring (all optional — see manual-tailor.mjs for a
# zero-cost path that needs neither key) ---
# Set ANTHROPIC_API_KEY and/or GEMINI_API_KEY. If both are set, Claude is used
# (see TAILOR_PROVIDER below to override). Leave both blank and use
# `npm run manual-tailor` instead — scan/track work fully offline either way,
# with the rule-based scorer, no API cost.

# Claude — get a key at https://console.anthropic.com/settings/keys, add a
# small amount of credit (this task costs roughly $0.02-0.03/resume on Haiku).
ANTHROPIC_API_KEY=""
# claude-haiku-4-5: this task is structured extraction/rephrasing into a fixed
# JSON schema, not deep reasoning — a frontier model buys nothing here at
# 5-25x the cost. Bump to a larger model only if Haiku's output quality
# genuinely falls short after reviewing a batch of real resumes.
CLAUDE_MODEL="claude-haiku-4-5"

# Gemini — fallback / alternative. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Google's free tier has historically capped around 20 requests/DAY per
# model (not per-minute — retries can't wait it out same-day). Verify current
# limits for whatever model you pick before relying on it for a big batch.
GEMINI_MODEL="gemini-2.5-flash"

# Force a provider instead of auto-detecting from which key is set: "claude" or "gemini"
TAILOR_PROVIDER=""
